{
	"extends": "@haltcase/style/typescript/node",
	"compilerOptions": {
		"customConditions": ["development"],
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["**/*.ts", "*.ts"],
	"exclude": ["node_modules", "src", "dist"]
}
